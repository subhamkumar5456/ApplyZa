# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── AI — Gemini ────────────────────────────────────────────────
# Supports multi-key rotation: GEMINI_API_KEY_1, GEMINI_API_KEY_2, ...
# Falls back to GEMINI_API_KEY if numbered keys are not set.
GEMINI_API_KEY=your_gemini_api_key

# ── AI — HuggingFace ──────────────────────────────────────────
# Supports multi-key rotation: HUGGINGFACE_API_KEY_1, HUGGINGFACE_API_KEY_2, ...
# Falls back to HUGGINGFACE_API_KEY if numbered keys are not set.
HUGGINGFACE_API_KEY=your_huggingface_api_key

# ── LaTeX Compiler ────────────────────────────────────────────
LATEX_COMPILE_API_URL=https://texlive.net/cgi-bin/latexcgi

# ── Feature Flags ─────────────────────────────────────────────
ENABLE_RESUME_REFINER=true
NEXT_PUBLIC_ENABLE_RESUME_REFINER=true
ENABLE_COVER_LETTER_GENERATOR=true
NEXT_PUBLIC_ENABLE_COVER_LETTER_GENERATOR=true

# ── Gmail SMTP (optional — for email notifications) ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=ApplyZa <your_gmail@gmail.com>
